# =============================================================
# Ansible / QCS Labo 用 .gitignore
# =============================================================

# Ansible 実行時の生成物
*.retry
*.log

# Vault パスワードファイル（絶対にコミットしない）
.vault_pass
vault_pass.txt

# 秘密鍵（絶対にコミットしない）
*.pem
*.key
id_rsa
id_rsa.*

# 実環境固有のインベントリ（テンプレートは残し、実値はコミットしない場合）
# inventory/hosts.local.ini

# Python 仮想環境 / キャッシュ
.venv/
venv/
__pycache__/
*.pyc

# Excel 生成物の一時ファイル
~$*.xlsx
# パラメータシートは all.yml から再生成可能なため成果物はコミットしない
qcs_labo/docs/QCS_Labo_パラメータシート.xlsx

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
